{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "stage",
    "score",
    "confidence",
    "requirements",
    "strengths",
    "gaps",
    "hard_blockers",
    "risks",
    "recommended_positioning",
    "decision_hint"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {"enum": ["average-fit", "red-team"]},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "importance", "status", "fact_ids", "reasoning"],
        "additionalProperties": false,
        "properties": {
          "requirement": {"type": "string"},
          "importance": {"enum": ["must", "preferred", "context"]},
          "status": {
            "enum": ["confirmed", "partial", "missing", "unknown", "not-applicable"]
          },
          "fact_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "reasoning": {"type": "string"}
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hard_blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_positioning": {"type": "string"},
    "decision_hint": {"enum": ["apply", "need-review", "skip"]}
  }
}

